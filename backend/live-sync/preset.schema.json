{
  "$defs": {
    "CalibratedRing": {
      "additionalProperties": false,
      "properties": {
        "ring_id": {
          "maxLength": 100,
          "pattern": "^ring-[a-z0-9-]+$",
          "title": "Ring Id",
          "type": "string"
        },
        "map_id": {
          "const": "lower-reshanta",
          "default": "lower-reshanta",
          "title": "Map Id",
          "type": "string"
        },
        "zone_id": {
          "title": "Zone Id",
          "type": "string"
        },
        "sector": {
          "anyOf": [
            {
              "enum": [
                "MID",
                "BOT",
                "TOP"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "geographic_description": {
          "default": "",
          "title": "Geographic Description",
          "type": "string"
        },
        "category": {
          "enum": [
            "siege",
            "transit"
          ],
          "title": "Category",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/RingPosition"
        },
        "default_callsign": {
          "anyOf": [
            {
              "pattern": "^[MBT][1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Callsign"
        }
      },
      "required": [
        "ring_id",
        "zone_id",
        "display_name",
        "category",
        "source",
        "position"
      ],
      "title": "CalibratedRing",
      "type": "object"
    },
    "Coordinate": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Coordinate",
      "type": "object"
    },
    "CustomMarker": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^(local-[a-z0-9-]+|objective-p[1-9][0-9]*)$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Coordinate"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "scale": {
          "default": 1.0,
          "maximum": 1.8,
          "minimum": 0.65,
          "title": "Scale",
          "type": "number"
        },
        "category": {
          "default": "Tático",
          "maxLength": 32,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "origin": {
          "default": "custom",
          "enum": [
            "default",
            "custom"
          ],
          "title": "Origin",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "position"
      ],
      "title": "CustomMarker",
      "type": "object"
    },
    "RingPosition": {
      "additionalProperties": false,
      "properties": {
        "map_position": {
          "$ref": "#/$defs/Coordinate"
        },
        "source": {
          "maxLength": 420,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "provisional",
            "verified"
          ],
          "title": "Status",
          "type": "string"
        },
        "world_coordinates": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "World Coordinates"
        },
        "altitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Altitude"
        }
      },
      "required": [
        "map_position",
        "source",
        "status"
      ],
      "title": "RingPosition",
      "type": "object"
    },
    "TacticalDrawing": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^shape-[a-z0-9-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "rectangle",
            "ellipse",
            "arrow"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/Coordinate"
        },
        "end": {
          "$ref": "#/$defs/Coordinate"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "width": {
          "default": 2.0,
          "maximum": 10,
          "minimum": 0.75,
          "title": "Width",
          "type": "number"
        },
        "opacity": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0.1,
          "title": "Opacity",
          "type": "number"
        },
        "stroke": {
          "default": "dashed",
          "enum": [
            "dashed",
            "solid"
          ],
          "title": "Stroke",
          "type": "string"
        },
        "head_size": {
          "default": 15.0,
          "maximum": 36,
          "minimum": 4,
          "title": "Head Size",
          "type": "number"
        },
        "label": {
          "default": "",
          "maxLength": 60,
          "title": "Label",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "start",
        "end"
      ],
      "title": "TacticalDrawing",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              2,
              3
            ]
          }
        }
      },
      "then": {
        "required": [
          "markers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 3
          }
        }
      },
      "then": {
        "required": [
          "drawings"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "default": 3,
      "enum": [
        1,
        2,
        3
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "map_id": {
      "const": "lower-reshanta",
      "default": "lower-reshanta",
      "title": "Map Id",
      "type": "string"
    },
    "map_frame": {
      "const": "Abyss_Reshanta_A",
      "default": "Abyss_Reshanta_A",
      "title": "Map Frame",
      "type": "string"
    },
    "name": {
      "maxLength": 70,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "layers": {
      "items": {
        "enum": [
          "SiegeObjectives",
          "SiegeRings",
          "TransitRings",
          "Pets",
          "Gathering",
          "CustomMarkers",
          "TacticalShapes"
        ],
        "type": "string"
      },
      "title": "Layers",
      "type": "array",
      "uniqueItems": true
    },
    "colors": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "SiegeObjectives",
          "SiegeRings",
          "TransitRings",
          "Pets",
          "Gathering",
          "CustomMarkers",
          "TacticalShapes"
        ]
      },
      "title": "Colors",
      "type": "object"
    },
    "use_local_calibration": {
      "default": false,
      "title": "Use Local Calibration",
      "type": "boolean"
    },
    "marker_scale": {
      "default": 1.0,
      "maximum": 1.8,
      "minimum": 0.65,
      "title": "Marker Scale",
      "type": "number"
    },
    "aliases": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 250,
      "title": "Aliases",
      "type": "object"
    },
    "markers": {
      "items": {
        "$ref": "#/$defs/CustomMarker"
      },
      "title": "Markers",
      "type": "array"
    },
    "drawings": {
      "items": {
        "$ref": "#/$defs/TacticalDrawing"
      },
      "title": "Drawings",
      "type": "array"
    },
    "calibrated_rings": {
      "items": {
        "$ref": "#/$defs/CalibratedRing"
      },
      "maxItems": 250,
      "title": "Calibrated Rings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "map_id",
    "name"
  ],
  "title": "Preset",
  "type": "object"
}
